# As in the original, doors have to be opened first. Each door is a pair of
# objects, one per room (o437/o322, o323/o894); state 1 = open.
object bar_entrance o437.name
  on open
    state bar_entrance 1
    state bar_door 1
  end
  on close
    state bar_entrance 0
    state bar_door 0
  end
  on walk
    if bar_entrance open
      room scummbar at 30 54 face right
    end
  end
end

object archway o436.name
  on walk
    # Archway to the town (o436): room 35 at the right archway
    room street at 194 48 face left
    walk guybrush 184 58
  end
end

# --- SCUMM Bar -----------------------------------------------------------------
object bar_door o322.name
  on open
    state bar_door 1
    state bar_entrance 1
  end
  on close
    state bar_door 0
    state bar_entrance 0
  end
  on walk
    if bar_door open
      if not seen_ghostship
        # On first leaving the bar (o322, bit 446): s117
        set seen_ghostship
        room meanwhile
        wait 60
        say narrator s117#1
        room ghostship
        music ghost_music
        say narrator s117#3
        room ghostcabin
        put lechuck 54 52
        face lechuck left
        put ghost 169 52
        face ghost left
        wait 60
        walk ghost 93 52
        say ghost s117#5
        say lechuck s117#6
        say ghost s117#7
        walk lechuck 70 52
        say lechuck s117#8
        say ghost s117#9
        say lechuck s117#10
        say ghost s117#11
        say lechuck s117#12
        say ghost s117#13
        say lechuck s117#14
        wait 30
        walk ghost 108 52
        wait 30
        walk lechuck 89 52
        face ghost left
        say ghost s117#15
        say ghost s117#16
        walk ghost 120 52
        face ghost left
        say lechuck s117#17
        walk lechuck 54 52
        say lechuck s117#18
        wait 60
        say ghost s117#19
        walk ghost 151 52
        music stop
      end
      room dock at 318 58 face front
    end
  end
end

# The cook (r28.s211–s216): he waits in the kitchen for 30 to 50 seconds (s211),
# comes out, brings a pirate grog and goes back (s216). In the original
# he picks the pirate at random; here he alternates between one at the left
# edge and one with the important-looking pirates. If the background routine
# is restarted while he is outside, he carries on from there as in s216.
routine cook
  repeat
    if not cook_out
      if cook_called
        # r28.s212: after the call at the door he comes out after ten seconds
        wait 600
        clear cook_called
      else
        wait random 1800 3000
      end
      set cook_out
      state kitchen_door 1
      state kitchen_exit 1
      put cook 293 55
      walk cook 264 56
    end
    if cook_far
      clear cook_far
      walk cook 210 57
    else
      set cook_far
      walk cook 51 56
    end
    walk cook 264 56
    state kitchen_door 1
    state kitchen_exit 1
    walk cook 293 55
    remove cook
    state kitchen_door 0
    state kitchen_exit 0
    clear cook_out
  end
end

# Click on the kitchen door (r28.s203, s214, s215). The original already checks
# on the click where the cook is, so the door is placed “direct” and the
# handlers let Guybrush walk there himself:
# - If the cook is outside and far away (x ≤ 310 in the original), he stays
#   put and the door works normally.
# - If he is outside and closer, he warns Guybrush (s215)
#   and then keeps serving (x > 520) or goes back into the kitchen.
# - If he is in the kitchen waiting (s211), he opens the door when it is opened,
#   calls from inside and closes it again (s214); ten seconds later
#   he comes out (s212). During these ten seconds the door opens.
object kitchen_door o323.name
  on open
    if cook_out
      if cook x < 138
        stop cook
        halt cook
        walk guybrush 264 56
        state kitchen_door 1
        state kitchen_exit 1
      else
        halt cook
        face cook right
        say cook r28.s215#1
        if not cook x < 231
          start cook
        else
          stop cook
          walk cook 264 56
          state kitchen_door 1
          state kitchen_exit 1
          walk cook 293 55
          remove cook
          state kitchen_door 0
          state kitchen_exit 0
          clear cook_out
          start cook
        end
      end
    else
      walk guybrush 264 56
      if cook_called
        state kitchen_door 1
        state kitchen_exit 1
      else
        state kitchen_door 1
        state kitchen_exit 1
        wait 30
        say narrator r28.s214#1
        state kitchen_door 0
        state kitchen_exit 0
        set cook_called
        start cook
      end
    end
  end
  on close
    walk guybrush 264 56
    state kitchen_door 0
    state kitchen_exit 0
  end
  on walk
    if cook_out
      if cook x < 138
        stop cook
        halt cook
        walk guybrush 264 56
        if kitchen_door open
          walk guybrush 293 54
          room kitchen at 23 57 face right
        end
      else
        halt cook
        face cook right
        say cook r28.s215#1
        if not cook x < 231
          start cook
        else
          stop cook
          walk cook 264 56
          state kitchen_door 1
          state kitchen_exit 1
          walk cook 293 55
          remove cook
          state kitchen_door 0
          state kitchen_exit 0
          clear cook_out
          start cook
        end
      end
    else
      walk guybrush 264 56
      if kitchen_door open
        walk guybrush 293 54
        room kitchen at 23 57 face right
      end
    end
  end
end

# The cook himself has no verbs of his own (r28: actor 6 without an object).
object cook_obj r28.en#1
end

