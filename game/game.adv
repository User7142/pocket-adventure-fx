# Pocket Adventure FX – Spielbeschreibung (die ersten Szenen von „The Secret of Monkey Island“, Teil 1)
#
# Sprache und Befehle: siehe README.md, Abschnitt „Skriptsprache“.
#
# Diese Datei enthält keine Texte, Grafiken oder Musik des Originals, nur
# Verweise darauf. Beim Bauen kommen sie aus der eigenen Originalkopie
# (VGA-Diskettenversion), die Texte aus jeder angegebenen Sprachfassung:
#   r38.s203#1    erster Text in Skript 203 von Raum 38
#   o498.name     Name von Objekt 498
#   s22#10        Text in globalem Skript 22 (hier: die Verbnamen)
# Liste aller Texte einer Kopie: tools/scumm_text.py <Kopie> [--filter r38.]
# Mit :N nur die N-te Sprechblase eines Originaltexts (r38.s202#41:2).
#
# Abläufe und Zeilen folgen den Originalskripten (Bezug jeweils im
# Kommentar), gekürzt auf das, was auf 128×64 Pixeln und 2,5 KB RAM geht.
# Koordinaten: Raumpixel nach der Verkleinerung auf 64 px Höhe
# (Original × 64/144), y = Fußlinie der Figuren.

# Titel: Mêlée Island bei Nacht (Raum 10) mit dem Logo (Objekt 113)
title original 10 overlay 113 48 24 crop 40 16 280 144 tone 40 120 contrast 0.6 music theme
cursor "art/ui/cursor.png"
inventoryverb look

# --- Musik -----------------------------------------------------------------
# Melodiestimme der AdLib-Fassungen. Sound 110 ist das Titelthema (das
# Startskript s1 wählt es für AdLib-Rechner); sein Anfang ist ein 20 s langer
# Klangteppich, die Melodie setzt nach rund 25 s ein. Sound 108 spielt der
# Ausguck beim ersten Besuch, Sound 101 läuft in der SCUMM Bar; das Dock ist
# still (alles wie in den Originalskripten).
music theme original 110 channel 0 start 25200
music lookout_music original 108
music bar_music original 101
# Kapitelkarte „Teil 1“: Raum 96 spielt Var[81] (AdLib: Sound 104) bis zum Ende
# Die Melodie setzt erst nach 2,2 s ein; bis dahin spielt der Lautsprecher die
# Einleitungsfigur der Begleitung (Kanal 1), sonst wäre es so lange still.
music part1_music original 104 lead 1
# Geisterschiff (s117, Var[76] = Sound 100): Die Melodie ist Kanal 3; die
# automatische Wahl träfe Kanal 0, eine Akkordstimme, die einstimmig zerfällt.
music ghost_music original 100 channel 3
# Karte von Mêlée (r85.en startet Var[89], AdLib: Sound 112; r85.ex stoppt sie)
music map_music original 112 channel 1

# --- Kapitelkarte ------------------------------------------------------------
# Raum 96: Vollbild mit eingezeichnetem Text, je Sprachfassung eigenes Bild.
# Die Treppe am Ausguck lädt ihn beim ersten Abstieg (o494, Bit 395), danach
# geht es zum Dock.
card part1 original 96 music part1_music

# --- Verben (Reihenfolge = Menü; das erste muss walk sein) -------------------
# Namen aus dem Verbskript s22 des Originals.
verb walk   s22#5
verb open   s22#1
verb close  s22#2
verb give   s22#8 prep s22#28
verb pickup s22#6
verb look   s22#10
verb talk   s22#7
verb push   s22#3
verb pull   s22#4
verb use    s22#9 prep s22#26

# Standardantworten aus s3, dem Skript des Originals für Sätze ohne eigene
# Antwort des Objekts.
default look
  say guybrush s3#4
end
default pickup
  say guybrush s3#5
end
default open
  say guybrush s3#2
end
default close
  say guybrush s3#7
end
default talk
  say guybrush s3#7
end
default push
  say guybrush s3#3
end
default pull
  say guybrush s3#3
end
default use
  say guybrush s3#7
end
default give
  say guybrush s3#7
end

# --- Figuren ---------------------------------------------------------------
# Der erste Actor ist die Spielfigur. Kostüme aus dem Original: 1 = Guybrush,
# 33 = der Ausguck, 26 = der Koch. Etwas größer als die Kulisse (0,55 statt
# 0,44), damit die Figuren auf 1 Bit lesbar bleiben.
# depth: kleiner, je weiter hinten er steht (Skalierung der Laufflächen, etwa
# in der Stadtstraße und am Dock); die anderen Figuren ignorieren im Original
# die Laufflächen (Klasse 22) und bleiben gleich groß.
actor guybrush costume 1 scale 0.55 depth
# Auf der Karte von Mêlée trägt Guybrush die kleine Kartenfigur (r85.en: costume 3)
actor guybrush_map costume 3 scale 1.2
actor lookout  costume 33 scale 0.55 dark 75   # grauer Mantel: höhere Schwelle
actor cook     costume 26 scale 0.55 object cook_obj
# Die drei wichtig aussehenden Piraten: ein Actor mit Kostüm 24 (r28.s204)
actor leaders  costume 24 scale 0.55
# Geisterschiff (s117): LeChuck = Kostüm 32, der Geisterpirat = Kostüm 54
actor lechuck  costume 32 scale 0.55 dark 15   # dunkelblau: sonst ganz schwarz
# Voodoo-Lady (r29.s201): Kostüm 15
actor voodoo   costume 15 scale 0.55
# Stadtstraße (r35.en, s200): die drei Piraten an der Ecke mit Papagei
# (Kostüm 41, ein Actor), ihre Ratte (42) und der Kartenverkäufer (14)
actor men      costume 41 scale 0.55
actor rat      costume 42 scale 0.55
actor citizen  costume 14 scale 0.55
actor ghost    costume 54 scale 0.55

# --- Start: Ankunft beim Ausguck (r38.s203) ---------------------------------
# Guybrush kommt den Pfad herauf, stellt sich vor, verabschiedet sich, fragt
# noch einmal nach der SCUMM Bar und geht über die Treppe hinunter zum Dock.
start
  # Anfangszustand: das zweite Huhn-Objekt (o391#2) erscheint erst, wenn er das Huhn ansieht
  hide rubber_chicken
  room lookout at 141 31 face left
  walk guybrush 62 47
  face guybrush left
  say guybrush r38.s203#1
  say lookout r38.s203#2
  say guybrush r38.s203#3
  face lookout right
  say lookout r38.s203#4
  say guybrush r38.s203#5
  say lookout r38.s203#6
  say lookout r38.s203#7
  say guybrush r38.s203#8
  say lookout r38.s203#9
  walk guybrush 104 50
  say guybrush r38.s203#10
  say lookout r38.s203#11
  say guybrush r38.s203#12
  card part1
  room dock at 4 34 face right
  walk guybrush 30 57
end

# --- Ausguck ---------------------------------------------------------------
# r38.s141: Der Ausguck merkt sich den Namen falsch. Aus dem Nachnamen (s141#1) wird
# zufällig etwas anderes; '@' (64) füllt auf und wird nicht gezeigt.
string lookout_name original 30

# r38.s202: das spätere Gespräch mit dem Ausguck. Erst etwas Smalltalk, dann
# erschrickt er; danach geht es um Guybrushs Namen, bis er fragt, wer der
# Ausguck ist – ab da gilt das zweite Menü. Hat Guybrush ihn nach dem
# Gouverneur und nach seiner Blindheit gefragt, ist der Ausguck künftig
# beschäftigt. Merker, die im Original nur für ein Gespräch gelten
# (lk_over, lk_quiet, lk_offer), setzt das Gespräch zu Beginn zurück.
object old_man o498.name
  on look
    say guybrush o498#1
  end
  on talk
    if lk_busy
      face lookout front
      say lookout r38.s202#4
    else
      clear lk_over
      clear lk_quiet
      clear lk_offer
      face lookout front
      choose
        option r38.s202#5
          say guybrush r38.s202#5
          done
        option r38.s202#6
          say guybrush r38.s202#6
          done
        option r38.s202#7
          say guybrush r38.s202#7
          done
        option r38.s202#8
          say guybrush r38.s202#8
          done
        option r38.s202#9 if lk_who
          say guybrush r38.s202#9
          done
      end
      say lookout r38.s202#10
      if lk_met
        setstring lookout_name s141#1
        random
        case
          setchar lookout_name 5 98
        case
          setchar lookout_name 5 100
        case
          setchar lookout_name 5 102
        case
          setchar lookout_name 5 107
        case
          setchar lookout_name 5 109
        case
          setchar lookout_name 5 110
        case
          setchar lookout_name 5 116
        case
          setchar lookout_name 5 122
        end
        random
        case
        case
          setchar lookout_name 3 111
          setchar lookout_name 4 111
        case
          setchar lookout_name 3 97
          setchar lookout_name 4 64
        case
          setchar lookout_name 3 117
          setchar lookout_name 4 64
        case
          setchar lookout_name 5 64
        case
          setchar lookout_name 2 117
          setchar lookout_name 3 109
          setchar lookout_name 4 112
          setchar lookout_name 5 64
        end
        random
        case
        case
          setchar lookout_name 8 114
        case
          setchar lookout_name 7 97
          setchar lookout_name 8 108
        case
          setchar lookout_name 7 105
          setchar lookout_name 8 110
        end
        random
        case
          setchar lookout_name 9 107
        case
        case
        case
        end
        say lookout r38.s202#11
        set lk_quiet
        set lk_offer
      else
        say lookout r38.s202#12
        say lookout r38.s202#13
      end
      if not lk_who
        choose
          option r38.s202#14 if not lk_named and not lk_squinky
            say guybrush r38.s202#14
            set lk_named
            say guybrush r38.s202#22
            say lookout r38.s202#23
            say lookout r38.s202#24
            if lk_squinky
              say lookout r38.s202#25
            end
            clear lk_quiet
          option r38.s202#15 if not lk_named and lk_squinky
            say guybrush r38.s202#15
            set lk_named
            say guybrush r38.s202#22
            say lookout r38.s202#23
            say lookout r38.s202#24
            if lk_squinky
              say lookout r38.s202#25
            end
            clear lk_quiet
          option r38.s202#16 if lk_named and not lk_quiet
            say guybrush r38.s202#16
            set lk_quiet
            say lookout r38.s202#46
            say lookout r38.s202#47
          option r38.s202#17 if not lk_squinky
            say guybrush r38.s202#17
            set lk_squinky
            set lk_quiet
            if not lk_named
              say lookout r38.s202#26
            else
              say lookout r38.s202#27
              say guybrush r38.s202#28
              say lookout r38.s202#29
            end
          option r38.s202#18 if not lk_over
            say guybrush r38.s202#18
            set lk_over
            face lookout right
            say lookout r38.s202#30
          option r38.s202#19
            say guybrush r38.s202#19
            set lk_who
            set lk_quiet
            say lookout r38.s202#31
            face lookout left
            say lookout r38.s202#32
            if lk_over
              face lookout right
            else
              face lookout front
            end
            say lookout r38.s202#33
            done
          option r38.s202#21
            say guybrush r38.s202#21
            done
        end
      end
      if lk_who
        choose
          option r38.s202#35 if lk_offer
            say guybrush r38.s202#35
            clear lk_offer
            say lookout r38.s202#44
            random
            case
            case
              say lookout r38.s202#45
            end
          option r38.s202#36 if not lk_quiet
            say guybrush r38.s202#36
            clear lk_offer
            set lk_quiet
            say lookout r38.s202#46
            say lookout r38.s202#47
          option r38.s202#37 if not lk_gov
            say guybrush r38.s202#37
            clear lk_offer
            set lk_gov
            set lk_quiet
            say lookout r38.s202#41
          option r38.s202#38 if not lk_blind
            say guybrush r38.s202#38
            clear lk_offer
            set lk_blind
            set lk_quiet
            say lookout r38.s202#42
          option r38.s202#39 if not lk_over
            say guybrush r38.s202#39
            clear lk_offer
            set lk_over
            face lookout right
            say lookout r38.s202#43
          option r38.s202#40
            say guybrush r38.s202#40
            done
        end
      end
      if lk_gov and lk_blind
        set lk_busy
      end
      say lookout r38.s202#49
      face lookout left
      set lk_met
    end
  end
end

