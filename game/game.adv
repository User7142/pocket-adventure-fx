# r29.s210: the Voodoo Lady. She guesses his name, gives him the chicken
# and looks into the future; then she vanishes in a flash. If
# Guybrush comes back, nobody is there (Var[293] = 1).
object fortune_teller o396.name
  on talk
    if vl_gone
      choose
        option r29.s210#48
          say guybrush r29.s210#48
          wait 60
          say guybrush r29.s210#51
          wait 60
          done
        option r29.s210#49
          say guybrush r29.s210#49
          wait 60
          say guybrush r29.s210#51
          wait 60
          done
        option r29.s210#50
          say guybrush r29.s210#50
          done
      end
    else
      face guybrush right
      if not vl_met
        set vl_met
        say voodoo r29.s210#1
      else
        say voodoo r29.s210#2
      end
      clear vl_vision
      choose
        option r29.s210#3 if not vl_name
          say guybrush r29.s210#3
          set vl_name
          say voodoo r29.s210#9
          wait 30
          say voodoo r29.s210#10
          choose
            option r29.s210#11
              say guybrush r29.s210#11
              say voodoo r29.s210#13
              done
            option r29.s210#12
              say guybrush r29.s210#12
              set vl_journey
              say guybrush r29.s210#14
              say voodoo r29.s210#15
              done
          end
        option r29.s210#4 if got_chicken and not vl_chicken
          say guybrush r29.s210#4
          set vl_chicken
          say voodoo r29.s210#16
          wait 30
          say voodoo r29.s210#17
          say guybrush r29.s210#18
          say voodoo r29.s210#19
        option r29.s210#5 if not vl_palms
          say guybrush r29.s210#5
          set vl_palms
          say voodoo r29.s210#20
          choose
            option r29.s210#21
              say guybrush r29.s210#21
              set vl_vision
              done
            option r29.s210#22
              say guybrush r29.s210#22
              set vl_nofuture
              say voodoo r29.s210#23
              done
          end
          if vl_vision
            done
          end
        option r29.s210#6 if vl_nofuture
          say guybrush r29.s210#6
          clear vl_nofuture
          say voodoo r29.s210#25
          set vl_vision
          done
        option r29.s210#7 if vl_journey
          say guybrush r29.s210#7
          clear vl_journey
          say guybrush r29.s210#26
          if vl_nofuture
            say voodoo r29.s210#27
            say voodoo r29.s210#28
            choose
            option r29.s210#21
              say guybrush r29.s210#21
              set vl_vision
              done
            option r29.s210#22
              say guybrush r29.s210#22
              set vl_nofuture
              say voodoo r29.s210#23
              done
          end
          else
            set vl_vision
          end
          if vl_vision
            done
          end
        option r29.s210#8
          say guybrush r29.s210#8
          say voodoo r29.s210#24
          done
      end
      if vl_vision
        clear vl_nofuture
        clear vl_journey
        wait 60
        say voodoo r29.s210#29
        flash 60
        say voodoo r29.s210#30
        say voodoo r29.s210#31
        say guybrush r29.s210#32
        say voodoo r29.s210#33
        wait 60
        say guybrush r29.s210#34
        wait 60
        say voodoo r29.s210#35
        say guybrush r29.s210#36
        wait 30
        say voodoo r29.s210#37
        say guybrush r29.s210#38
        say voodoo r29.s210#39
        wait 60
        say voodoo r29.s210#40
        say voodoo r29.s210#41
        say voodoo r29.s210#42
        say guybrush r29.s210#43
        say voodoo r29.s210#44
        wait 30
        say voodoo r29.s210#45
        flash 90
        remove voodoo
        wait 30
        say guybrush r29.s210#46
        wait 180
        set vl_gone
      end
    end
  end
end

# --- Rooms -----------------------------------------------------------------
# Room 38 of the original, 320x144 → 142x64
room lookout original 38 tone 35 105 contrast 0.8
  walkboxes original

  # Order = drawing and click order: later ones are on top.
  place stairs original 494
  place path original 496
  place old_man original 498 face left
  # Campfire = original costume 48, as an image only
  place decor at 64 43 costume 48 states 0.44 speed 6

  entry
    put lookout 44 46
    face lookout right
    if not heard_lookout_music
      set heard_lookout_music
      music lookout_music
    end
  end
end

# Room 33 of the original: the dock, 1008x144 → 448x64
room dock original 33 tone 35 105 contrast 0.8
  walkboxes original
  entry
    music stop
  end
  place cliffside original 435 face left
  place poster original 438 face front
  place bar_entrance original 437 door face front
  place archway original 436 face right
end

# Room 28 of the original: the SCUMM Bar, 640x144 → 284x64. The pirates are
# object images (the first animation frame each).
room scummbar original 28 tone 55 95 contrast 0 overlay 374 375 376 377 335 341 353 350 356 344 359 362 347 365 368 370
  walkboxes original
  place fireplace original 329 face right
  place curtain original 334 face front
  place bar_door original 322 door face left
  place kitchen_door original 323 door direct face right
  place pirate_a original 341 face left
  place pirate_b original 356 face front
  place pirate_c original 344 face right
  place pirate_d original 347 face front
  place dog original 350 face front
  place leaders_obj original 332 face right
  place mug original 373 picture face left

  entry
    music bar_music
    # r28.s204: at the table at 440,132, facing forward
    put leaders 196 59
    face leaders front
    # r28.en/s205: The cook is in the kitchen, his background routine starts over.
    remove cook
    clear cook_out
    clear cook_called
    start cook
  end
end

# s117: an interstitial line (#1) on black, then the ghost ship on the lava
# river (room 70) and LeChuck's cabin (room 72), each 320×144 → 142×64. Both
# are almost only blue and red; the blue channel shows the ship as a bright
# silhouette against the lava and the cabin with its edges.
room meanwhile blank
end

room ghostship original 70 tone 20 110 contrast 0.8 channel blue
  walkboxes original
end

room ghostcabin original 72 tone 45 170 contrast 0.6 channel blue
  walkboxes original
end

# Room 35 of the original: the town street, 480×144 → 213×64
room street original 35 tone 80 220 contrast 0.4 channel max
  walkboxes original
  place street_archway original 458 face right
  place high_street original 459 face left
  place sign original 451 face front
  place clock original 457 face front
  place shop_door original 452 door face front
  place house_door_a original 453 door face front
  place house_door_b original 454 door face front
  place house_door_c original 455 door face front
  place house_door_d original 456 door face front
  place men_obj original 460
  place rat_obj original 461
  place citizen_obj original 448
  entry
    # r35.ex: Var[247] counts leaving if he has looked at the clock
    if clock_looked
      clear clock_looked
      add clock_visits 1
    end
    # r35.en/s200: the pirates on the left, their rat (as long as it has not
    # run away), the map seller on the right
    put men 22 55
    face men front
    put citizen 144 52
    face citizen front
    start braak_watch
    if rat_count < 5
      put rat 32 60
      face rat left
      start rat_watch
    end
  end
end

