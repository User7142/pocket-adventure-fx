# r35.s210: The clock always shows ten o'clock. The comment changes when
# Guybrush has left the street and comes back (Var[247], counted on
# leaving, provided he has looked at it).
object clock o457.name
  on look
    if clock_visits = 0
      say guybrush r35.s210#1
    else
      if clock_visits = 1
        say guybrush r35.s210#2
      else
        say guybrush r35.s210#3
        random
        case
          say guybrush r35.s210#4
        case
        case
        case
        case
        case
        end
      end
    end
    set clock_looked
  end
end

# Door to the Voodoo Lady's shop (o452/o381, a door pair)
object shop_door o452.name
  on open
    state shop_door 1
    state voodoo_door 1
  end
  on close
    state shop_door 0
    state voodoo_door 0
  end
  on walk
    if shop_door open
      room voodoo at 48 45 face right
      walk guybrush 54 47
      state shop_door 0
      state voodoo_door 0
    end
  end
end

# r35.s206/s207: Guybrush disappears behind the four house doors (o453–o456)
# and comes out of another one. Which door leads where is rolled by
# s206 the first time; the weights below are the probabilities of
# its method (in 36ths).
sub door_mapping
  random
  case 2
    let door_a_to 0
    let door_b_to 2
    let door_c_to 3
    let door_d_to 1
  case 3
    let door_a_to 0
    let door_b_to 3
    let door_c_to 1
    let door_d_to 2
  case 4
    let door_a_to 1
    let door_b_to 0
    let door_c_to 3
    let door_d_to 2
  case 2
    let door_a_to 1
    let door_b_to 2
    let door_c_to 3
    let door_d_to 0
  case 3
    let door_a_to 1
    let door_b_to 3
    let door_c_to 0
    let door_d_to 2
  case 4
    let door_a_to 2
    let door_b_to 0
    let door_c_to 3
    let door_d_to 1
  case 3
    let door_a_to 2
    let door_b_to 3
    let door_c_to 0
    let door_d_to 1
  case 3
    let door_a_to 2
    let door_b_to 3
    let door_c_to 1
    let door_d_to 0
  case 6
    let door_a_to 3
    let door_b_to 0
    let door_c_to 1
    let door_d_to 2
  case 3
    let door_a_to 3
    let door_b_to 2
    let door_c_to 0
    let door_d_to 1
  case 3
    let door_a_to 3
    let door_b_to 2
    let door_c_to 1
    let door_d_to 0
  end
end

sub door_a_in
  if not doors_mixed
    set doors_mixed
    call door_mapping
  end
  state house_door_a 1
  wait 15
  remove guybrush
  state house_door_a 0
  wait 30
  if door_a_to = 0
    call door_a_out
  end
  if door_a_to = 1
    call door_b_out
  end
  if door_a_to = 2
    call door_c_out
  end
  if door_a_to = 3
    call door_d_out
  end
end

sub door_b_in
  if not doors_mixed
    set doors_mixed
    call door_mapping
  end
  state house_door_b 1
  wait 15
  remove guybrush
  state house_door_b 0
  wait 30
  if door_b_to = 0
    call door_a_out
  end
  if door_b_to = 1
    call door_b_out
  end
  if door_b_to = 2
    call door_c_out
  end
  if door_b_to = 3
    call door_d_out
  end
end

sub door_c_in
  if not doors_mixed
    set doors_mixed
    call door_mapping
  end
  state house_door_c 1
  wait 15
  remove guybrush
  state house_door_c 0
  wait 30
  if door_c_to = 0
    call door_a_out
  end
  if door_c_to = 1
    call door_b_out
  end
  if door_c_to = 2
    call door_c_out
  end
  if door_c_to = 3
    call door_d_out
  end
end

sub door_d_in
  if not doors_mixed
    set doors_mixed
    call door_mapping
  end
  state house_door_d 1
  wait 15
  remove guybrush
  state house_door_d 0
  wait 30
  if door_d_to = 0
    call door_a_out
  end
  if door_d_to = 1
    call door_b_out
  end
  if door_d_to = 2
    call door_c_out
  end
  if door_d_to = 3
    call door_d_out
  end
end

sub door_a_out
  pan 59
  state house_door_a 1
  wait 15
  put guybrush 59 36
  face guybrush front
  wait 15
  state house_door_a 0
end

sub door_b_out
  pan 83
  state house_door_b 1
  wait 15
  put guybrush 83 36
  face guybrush front
  wait 15
  state house_door_b 0
end

sub door_c_out
  pan 92
  state house_door_c 1
  wait 15
  put guybrush 92 37
  face guybrush front
  wait 15
  state house_door_c 0
end

sub door_d_out
  pan 172
  state house_door_d 1
  wait 15
  put guybrush 172 48
  face guybrush front
  wait 15
  state house_door_d 0
end

object house_door_a o453.name
  on open
    call door_a_in
  end
  on use
    call door_a_in
  end
end
object house_door_b o454.name
