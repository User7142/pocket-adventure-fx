# Pocket Adventure FX – scene description (the first scenes of “The Secret of Monkey Island”, Part 1)
#
# Language and commands: see README.md, section “Scene description”.
#
# This file contains no text, graphics or music of the original, only
# references to them. At build time they come from your own copy of the game
# (VGA floppy version), the texts from every language version given:
#   r38.s203#1    first text in script 203 of room 38
#   o498.name     name of object 498
#   s22#10        text in global script 22 (here: the verb names)
# List of all texts of a copy: tools/scumm_text.py <copy> [--filter r38.]
# With :N only the N-th speech bubble of an original text (r38.s202#41:2).
#
# Routines and lines follow the original scripts (source given in the
# comment), cut down to what fits into 128×64 pixels and 2.5 KB of RAM.
# Coordinates: room pixels after scaling down to 64 px height
# (original × 64/144), y = baseline of the characters' feet.

# Title: Mêlée Island by night (room 10) with the logo (object 113)
title original 10 overlay 113 48 24 crop 40 16 280 144 tone 40 120 contrast 0.6 music theme
cursor "art/ui/cursor.png"
inventoryverb look

# --- Music -----------------------------------------------------------------
# Melody voice of the AdLib versions. Sound 110 is the title theme (the
# boot script s1 picks it for AdLib machines); it opens with a 20 s
# soundscape, the melody comes in after about 25 s. Sound 108 is played at the
# lookout on the first visit, sound 101 runs in the SCUMM Bar; the dock is
# silent (all as in the original scripts).
music theme original 110 channel 0 start 25200
music lookout_music original 108
music bar_music original 101
# Chapter card “Part 1”: room 96 plays Var[81] (AdLib: sound 104) to the end
# The melody only starts after 2.2 s; until then the speaker plays the
# intro figure of the accompaniment (channel 1), otherwise it would be silent.
music part1_music original 104 lead 1
# Ghost ship (s117, Var[76] = sound 100): the melody is channel 3; the
# automatic choice would pick channel 0, a chord voice that falls apart in mono.
music ghost_music original 100 channel 3
# Map of Mêlée (r85.en starts Var[89], AdLib: sound 112; r85.ex stops it)
music map_music original 112 channel 1

# --- Chapter card ------------------------------------------------------------
# Room 96: full screen with the text drawn in, one image per language version.
# The stairs at the lookout load it on the first descent (o494, bit 395), then
# it goes on to the dock.
card part1 original 96 music part1_music

# --- Verbs (order = menu; the first one must be walk) -----------------------
# Names from the original's verb script s22.
verb walk   s22#5
verb open   s22#1
verb close  s22#2
verb give   s22#8 prep s22#28
verb pickup s22#6
verb look   s22#10
verb talk   s22#7
verb push   s22#3
verb pull   s22#4
verb use    s22#9 prep s22#26

# Default responses from s3, the original's script for sentences without a
# response of their own from the object.
default look
  say guybrush s3#4
end
default pickup
  say guybrush s3#5
end
default open
  say guybrush s3#2
end
default close
  say guybrush s3#7
end
default talk
  say guybrush s3#7
end
default push
  say guybrush s3#3
end
default pull
  say guybrush s3#3
end
default use
  say guybrush s3#7
end
default give
  say guybrush s3#7
end

# --- Characters ------------------------------------------------------------
# The first actor is the player character. Original costumes: 1 = Guybrush,
# 33 = the lookout, 26 = the cook. Slightly larger than the background (0.55
# instead of 0.44), so the characters stay readable at 1 bit.
# depth: smaller the further back he stands (walk box scaling, e.g.
# in the town street and on the dock); in the original the other characters
# ignore the walk boxes (class 22) and keep the same size.
actor guybrush costume 1 scale 0.55 depth
# On the map of Mêlée Guybrush wears the small map figure (r85.en: costume 3)
actor guybrush_map costume 3 scale 1.2
actor lookout  costume 33 scale 0.55 dark 75   # grey coat: higher threshold
actor cook     costume 26 scale 0.55 object cook_obj
# The three important-looking pirates: one actor with costume 24 (r28.s204)
actor leaders  costume 24 scale 0.55
# Ghost ship (s117): LeChuck = costume 32, the ghost pirate = costume 54
actor lechuck  costume 32 scale 0.55 dark 15   # dark blue: otherwise all black
# Voodoo Lady (r29.s201): costume 15
actor voodoo   costume 15 scale 0.55
# Town street (r35.en, s200): the three pirates on the corner with a parrot
# (costume 41, one actor), their rat (42) and the map seller (14)
actor men      costume 41 scale 0.55
actor rat      costume 42 scale 0.55
actor citizen  costume 14 scale 0.55
actor ghost    costume 54 scale 0.55

# --- Start: arrival at the lookout (r38.s203) -------------------------------
# Guybrush comes up the path, introduces himself, says goodbye, asks
# once more about the SCUMM Bar and goes down the stairs to the dock.
start
  # Initial state: the second chicken object (o391#2) only appears once he looks at the chicken
  hide rubber_chicken
  room lookout at 141 31 face left
  walk guybrush 62 47
  face guybrush left
  say guybrush r38.s203#1
  say lookout r38.s203#2
  say guybrush r38.s203#3
  face lookout right
  say lookout r38.s203#4
  say guybrush r38.s203#5
  say lookout r38.s203#6
  say lookout r38.s203#7
  say guybrush r38.s203#8
  say lookout r38.s203#9
  walk guybrush 104 50
  say guybrush r38.s203#10
  say lookout r38.s203#11
  say guybrush r38.s203#12
  card part1
  room dock at 4 34 face right
  walk guybrush 30 57
end

# --- Lookout ---------------------------------------------------------------
# r38.s141: The lookout gets the name wrong. The surname (s141#1) is
# randomly turned into something else; '@' (64) pads and is not shown.
string lookout_name original 30

# r38.s202: the later conversation with the lookout. First some small talk,
# then he is startled; after that it is about Guybrush's name until he asks
# who the lookout is – from then on the second menu applies. Once Guybrush
# has asked him about the governor and about his blindness, the lookout is
# busy from then on. Flags that in the original only last one conversation
# (lk_over, lk_quiet, lk_offer) are reset at the start of the conversation.
object old_man o498.name
  on look
    say guybrush o498#1
  end
  on talk
    if lk_busy
      face lookout front
      say lookout r38.s202#4
    else
      clear lk_over
      clear lk_quiet
      clear lk_offer
      face lookout front
      choose
        option r38.s202#5
          say guybrush r38.s202#5
          done
        option r38.s202#6
          say guybrush r38.s202#6
          done
        option r38.s202#7
          say guybrush r38.s202#7
          done
        option r38.s202#8
          say guybrush r38.s202#8
          done
        option r38.s202#9 if lk_who
          say guybrush r38.s202#9
          done
      end
      say lookout r38.s202#10
      if lk_met
        setstring lookout_name s141#1
        random
        case
          setchar lookout_name 5 98
        case
          setchar lookout_name 5 100
        case
          setchar lookout_name 5 102
        case
          setchar lookout_name 5 107
        case
          setchar lookout_name 5 109
        case
          setchar lookout_name 5 110
        case
          setchar lookout_name 5 116
        case
          setchar lookout_name 5 122
        end
        random
        case
        case
          setchar lookout_name 3 111
          setchar lookout_name 4 111
        case
          setchar lookout_name 3 97
          setchar lookout_name 4 64
        case
          setchar lookout_name 3 117
          setchar lookout_name 4 64
        case
          setchar lookout_name 5 64
        case
          setchar lookout_name 2 117
          setchar lookout_name 3 109
          setchar lookout_name 4 112
          setchar lookout_name 5 64
        end
        random
        case
        case
          setchar lookout_name 8 114
        case
          setchar lookout_name 7 97
          setchar lookout_name 8 108
        case
          setchar lookout_name 7 105
          setchar lookout_name 8 110
        end
        random
        case
          setchar lookout_name 9 107
        case
        case
        case
        end
        say lookout r38.s202#11
        set lk_quiet
        set lk_offer
      else
        say lookout r38.s202#12
        say lookout r38.s202#13
      end
      if not lk_who
        choose
          option r38.s202#14 if not lk_named and not lk_squinky
            say guybrush r38.s202#14
            set lk_named
            say guybrush r38.s202#22
            say lookout r38.s202#23
            say lookout r38.s202#24
            if lk_squinky
              say lookout r38.s202#25
            end
            clear lk_quiet
          option r38.s202#15 if not lk_named and lk_squinky
            say guybrush r38.s202#15
            set lk_named
            say guybrush r38.s202#22
            say lookout r38.s202#23
            say lookout r38.s202#24
            if lk_squinky
              say lookout r38.s202#25
            end
            clear lk_quiet
          option r38.s202#16 if lk_named and not lk_quiet
            say guybrush r38.s202#16
            set lk_quiet
            say lookout r38.s202#46
            say lookout r38.s202#47
          option r38.s202#17 if not lk_squinky
            say guybrush r38.s202#17
            set lk_squinky
            set lk_quiet
            if not lk_named
              say lookout r38.s202#26
            else
              say lookout r38.s202#27
              say guybrush r38.s202#28
              say lookout r38.s202#29
            end
          option r38.s202#18 if not lk_over
            say guybrush r38.s202#18
            set lk_over
            face lookout right
            say lookout r38.s202#30
          option r38.s202#19
            say guybrush r38.s202#19
            set lk_who
            set lk_quiet
            say lookout r38.s202#31
            face lookout left
            say lookout r38.s202#32
            if lk_over
              face lookout right
            else
              face lookout front
            end
            say lookout r38.s202#33
            done
          option r38.s202#21
            say guybrush r38.s202#21
            done
        end
      end
      if lk_who
        choose
          option r38.s202#35 if lk_offer
            say guybrush r38.s202#35
            clear lk_offer
            say lookout r38.s202#44
            random
            case
            case
              say lookout r38.s202#45
            end
          option r38.s202#36 if not lk_quiet
            say guybrush r38.s202#36
            clear lk_offer
            set lk_quiet
            say lookout r38.s202#46
            say lookout r38.s202#47
          option r38.s202#37 if not lk_gov
            say guybrush r38.s202#37
            clear lk_offer
            set lk_gov
            set lk_quiet
            say lookout r38.s202#41
          option r38.s202#38 if not lk_blind
            say guybrush r38.s202#38
            clear lk_offer
            set lk_blind
            set lk_quiet
            say lookout r38.s202#42
          option r38.s202#39 if not lk_over
            say guybrush r38.s202#39
            clear lk_offer
            set lk_over
            face lookout right
            say lookout r38.s202#43
          option r38.s202#40
            say guybrush r38.s202#40
            done
        end
      end
      if lk_gov and lk_blind
        set lk_busy
      end
      say lookout r38.s202#49
      face lookout left
      set lk_met
    end
  end
end

