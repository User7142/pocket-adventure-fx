# --- Greyscale (2 bit) --------------------------------------------------------
# One greyscale version per image (tools/original.py: to_grey); in the game
# switchable between greyscale and black and white via the menu. The values were
# chosen on the device: the OLED shows grey much brighter than any preview.
# Unless given, the room's tone range and channel apply; gamma > 1 darkens the
# midtones, contrast emphasises edges as in the 1-bit version.

# Title: sky and mountain light grey at most, the logo cut out, bright and
# outlined in black – otherwise it gets lost in the brightened sky.
greyscale title
  layer weights 0.3 0.3 0.4 tone 15 110 max 2
  subject hue magenta weights 0.5 0 0.5 tone 60 160 min 1 outline
end

# Chapter card: lettering; dithered, the edges stay soft.
greyscale card part1
  layer gamma 1.3 dither
end

greyscale room lookout
  layer contrast 0.8 gamma 1.3
end

greyscale room dock
  layer contrast 0.8 gamma 1.3
end

greyscale room scummbar
  layer contrast 0.5 gamma 1.3
end

# Ghost ship: blue weighted strongly so that the ship stands out bright
# against the lava, and outlined in black.
greyscale room ghostship
  layer weights 0.4 0.3 0.9 tone 20 170
  subject hue blue outline
end

greyscale room ghostcabin
  layer contrast 0.6 gamma 1.3
end

greyscale room street
  layer contrast 0.5 gamma 1.3
end

greyscale room voodoo
  layer contrast 0.8 gamma 1.3
end

greyscale room map
  layer contrast 2.0 gamma 1.3
end

# Kitchen: inside like the other rooms, outside (from the wall at x 212.5) with
# its own tone range. The pier has the same colour as the water; its outline
# is traced by hand (original coordinates), it becomes bright and outlined.
greyscale room kitchen
  layer contrast 0.5 gamma 1.3
  layer from 212.5 tone auto gamma 1.3
  subject polygon 216 125  254 125  254 117  265 117  265 125  278 125  278 124  287 124  287 127  310 127  310 133  287 133  287 137  278 137  278 135  266 135  266 144  258 144  258 135  216 135 channel max tone auto min 1 outline
end
