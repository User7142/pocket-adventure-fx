# r28.s220: das Gespräch mit den wichtig aussehenden Piraten. Beim ersten
# Mal fragen sie, was er will; nach der Antwort #14 erklären sie die
# drei Prüfungen und es geht gleich mit den Fragen weiter. Danach beginnt
# jedes Gespräch mit dem Gruß und den Fragen. Die Chöre (#26–28,
# #40–42, #64–66 usw.) stehen im Original dreistimmig
# versetzt auf dem Bild; hier erscheint jeweils die letzte Stimme.
object leaders_obj o332.name
  on talk
    if told_pirate
      say leaders r28.s220#3
    else
      say leaders r28.s220#12
      choose
        option r28.s220#13
          say guybrush r28.s220#13
          say leaders r28.s220#45
          done
        option r28.s220#14
          say guybrush r28.s220#14
          say leaders r28.s220#16
          say leaders r28.s220#17
          say leaders r28.s220#18
          say leaders r28.s220#19
          say leaders r28.s220#20
          say leaders r28.s220#21
          say leaders r28.s220#22
          say guybrush r28.s220#23
          say leaders r28.s220#24
          say leaders r28.s220#25
          say narrator r28.s220#28
          say guybrush r28.s220#30
          say leaders r28.s220#31
          say leaders r28.s220#32
          say leaders r28.s220#33
          say leaders r28.s220#34
          say leaders r28.s220#35
          say leaders r28.s220#36
          say leaders r28.s220#37
          say leaders r28.s220#38
          say leaders r28.s220#39
          say narrator r28.s220#42
          set told_pirate
          done
        option r28.s220#15
          say guybrush r28.s220#15
          say leaders r28.s220#45
          done
      end
    end
    if told_pirate
      choose
        option r28.s220#47 if not asked_sword
          say guybrush r28.s220#47
          say leaders r28.s220#59
          say leaders r28.s220#60
          say leaders r28.s220#61
          say leaders r28.s220#62
          say leaders r28.s220#63
          say narrator r28.s220#66
          set asked_sword
        option r28.s220#48 if asked_sword
          say guybrush r28.s220#48
          say leaders r28.s220#59
          say leaders r28.s220#60
          say leaders r28.s220#61
          say leaders r28.s220#68
        option r28.s220#50 if not asked_idol
          say guybrush r28.s220#50
          say leaders r28.s220#69
          say leaders r28.s220#70
          say leaders r28.s220#71
          say leaders r28.s220#72
          say leaders r28.s220#73
          say leaders r28.s220#74
          say leaders r28.s220#75
          set asked_idol
        option r28.s220#51 if asked_idol
          say guybrush r28.s220#51
          say leaders r28.s220#72
          say leaders r28.s220#73
          say leaders r28.s220#74
          say leaders r28.s220#75
        option r28.s220#53 if not asked_treasure
          say guybrush r28.s220#53
          say leaders r28.s220#76
          say leaders r28.s220#77
          say guybrush r28.s220#78
          say leaders r28.s220#79
          say leaders r28.s220#80
          say narrator r28.s220#83
          set asked_treasure
        option r28.s220#54 if asked_treasure
          say guybrush r28.s220#54
          say leaders r28.s220#77
          say leaders r28.s220#80
          say narrator r28.s220#83
        option r28.s220#56 if not called_pigs
          say guybrush r28.s220#56
          say leaders r28.s220#88
          set called_pigs
        option r28.s220#57 if not asked_grog
          say guybrush r28.s220#57
          say leaders r28.s220#89
          say leaders r28.s220#90
          say leaders r28.s220#91
          say leaders r28.s220#92
          say leaders r28.s220#93
          say leaders r28.s220#94
          say leaders r28.s220#95
          say leaders r28.s220#96
          say leaders r28.s220#97
          say leaders r28.s220#98
          say leaders r28.s220#99
          say leaders r28.s220#100
          say leaders r28.s220#101
          say narrator r28.s220#104
          set asked_grog
        option r28.s220#58
          say guybrush r28.s220#58
          say leaders r28.s220#106
          say leaders r28.s220#107
          done
      end
    end
  end
  on give mug
    say leaders o332#1
  end
end

