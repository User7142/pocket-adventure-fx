sub squawk
  setstring squawk r35.s217#1
  let letter random 97 122
  setchar squawk 3 letter
  let letter random 97 122
  setchar squawk 4 letter
  say men r35.s217#2
end

# r35.s214/s215: If Guybrush gets close to the rat and points at it, the
# pirates warn him; the fifth time the rat runs away (Var[234] = 5).
routine rat_watch
  repeat
    wait 1
    if not hover rat_obj
      set rat_armed
    end
    if rat_armed and hover rat_obj and guybrush x < 76 and guybrush y > 48
      clear rat_armed
      add rat_count 1
      play rat_warning
    end
  end
end

cutscene rat_warning
  if rat_count = 1
    say men r35.s215#1
  end
  if rat_count = 2
    say men r35.s215#2
  end
  if rat_count = 3
    say men r35.s215#3
  end
  if rat_count = 4
    say men r35.s215#4
    say men r35.s215#5
  end
  if rat_count = 5
    walk rat 178 60
    face guybrush left
    say men r35.s215#6
    remove rat
    stop rat_watch
  end
end

# r35.s201: The map seller's parrot squawks every 13 to 17 seconds
# while the camera is on the left.
routine braak_watch
  repeat
    wait random 800 1000
    if guybrush x < 80
      play braak
    end
  end
end

cutscene braak
  say narrator r35.s201#1
end

object rat_obj o461.name
end

# r35.s216: the conversation with the pirates. Parts that the original jumps
# to from several places are subroutines; men_bye ends the
# conversation from within them.
object men_obj o460.name
  on look
    say men o460#1
  end
  on talk
    clear men_bye
    choose
      option r35.s216#2 if not m_rats and m_insulted
        say guybrush r35.s216#2
        call rat_story
        if men_bye
          done
        end
      option r35.s216#5 if not m_rats and not m_insulted and rat_count < 5
        say guybrush r35.s216#5
        call rat_question
        if men_bye
          done
        end
      option r35.s216#6 if not m_rats and not m_insulted and rat_count < 5
        say guybrush r35.s216#6
        call rat_insult
        if men_bye
          done
        end
      option r35.s216#3 if not m_rats and not m_insulted and not rat_count < 5
        say guybrush r35.s216#3
        call rat_question
        if men_bye
          done
        end
      option r35.s216#4 if not m_rats and not m_insulted and not rat_count < 5
        say guybrush r35.s216#4
        call rat_insult
        if men_bye
          done
        end
      option r35.s216#7 if not m_map and met_citizen
        say guybrush r35.s216#7
        call minutes_offer
        if men_bye
          done
        end
      option r35.s216#8 if not m_map and not met_citizen
        say guybrush r35.s216#8
        call minutes_offer
        if men_bye
          done
        end
      option r35.s216#9 if m_map and not has minutes
        say guybrush r35.s216#9
        call minutes_deal
      option r35.s216#10 if not m_circus and m_pirates
        say guybrush r35.s216#10
        call keg_menu
        if men_bye
          done
        end
      option r35.s216#11 if not m_circus and not m_pirates
        say guybrush r35.s216#11
        set m_pirates
        wait 60
        say men r35.s216#56
        wait 60
        if rat_count < 5
          say men r35.s216#57
        else
          say men r35.s216#58
        end
        say men r35.s216#59
        call squawk
        say men r35.s216#60
        call keg_menu
        if men_bye
          done
        end
      option r35.s216#13
        say guybrush r35.s216#13
        done
    end
  end
end

# 0C59: the story of the rats that sailed a ship – or monkeys
sub rat_story
  set m_rats
  say men r35.s216#41
  say men r35.s216#42
  wait 30
  call squawk
  say men r35.s216#43
  wait 30
  say men r35.s216#44
  say men r35.s216#45
  say men r35.s216#46
  choose
    option r35.s216#47
      say guybrush r35.s216#47
      say men r35.s216#51
      done
    option r35.s216#48
      say guybrush r35.s216#48
      say men r35.s216#52
      done
    option r35.s216#49
      say guybrush r35.s216#49
      say men r35.s216#53
      done
    option r35.s216#50
      say guybrush r35.s216#50
      set men_bye
      done
  end
  if not men_bye
    say men r35.s216#54
    wait 30
    say men r35.s216#55
  end
end

# 0964: the question about rats (#29)
sub rat_question
  say men r35.s216#29
  choose
    option r35.s216#30
      say guybrush r35.s216#30
      call rat_story
      done
    option r35.s216#31
      say guybrush r35.s216#31
      call rat_story
      done
    option r35.s216#32
      say guybrush r35.s216#32
      set m_insulted
      say men r35.s216#34
      call squawk
      set men_bye
      done
    option r35.s216#33
      say guybrush r35.s216#33
      set men_bye
      done
  end
end

# 0B62: He has insulted the rat. If it is still there, it answers itself.
sub rat_insult
  set m_insulted
  if rat_count < 5
    say rat r35.s216#36
    say rat r35.s216#37
    wait 30
    say men r35.s216#38
  else
    say men r35.s216#35
  end
  say men r35.s216#39
  say men r35.s216#98
  say men r35.s216#99
  call squawk
  set men_bye
end

# 056B: the maps on offer are really the minutes of a meeting (o472)
sub minutes_offer
  set m_map
  say men r35.s216#18
  say men r35.s216#19
  wait 120
  say men r35.s216#20
  say men r35.s216#21
  wait 60
  call squawk
  say men r35.s216#22
  choose
    option r35.s216#24
      say guybrush r35.s216#24
      say men r35.s216#27
      done
    option r35.s216#25
      say guybrush r35.s216#25
      set men_bye
      done
    option r35.s216#26
      say guybrush r35.s216#26
      call minutes_deal
      done
  end
end

# 092D: He takes the minutes and gets two pieces of eight for them.
sub minutes_deal
  say men r35.s216#28
  pickup minutes
  add money 2
  if not has money_obj
    pickup money_obj
  end
end

# 11E0: the menu after #61
sub keg_menu
  say men r35.s216#61
  choose
    option r35.s216#62 if not m_keg
      say guybrush r35.s216#62
      set m_keg
      say men r35.s216#67
      say men r35.s216#68
      wait 60
      say men r35.s216#69
      say men r35.s216#70
      wait 60
      say men r35.s216#71
      done
    option r35.s216#63 if not m_rats and m_insulted
      say guybrush r35.s216#63
      call rat_story
      done
    option r35.s216#64 if not m_rats and not m_insulted
      say guybrush r35.s216#64
      call rat_question
      done
    option r35.s216#65
      say guybrush r35.s216#65
      set men_bye
      done
    option r35.s216#66
      say guybrush r35.s216#66
      set m_circus
      say men r35.s216#72
      say men r35.s216#73
      say men r35.s216#74
      say men r35.s216#75
      say men r35.s216#76
      if not rat_count < 5
        say men r35.s216#77
      end
      wait 120
      say men r35.s216#78
      set men_bye
      done
  end
end

# r35.s218: the map seller. The first time he asks about cousin Sven
# (a code); then he offers the map to the treasure for 100 pieces of eight.
# The buy option (#33) only appears from 100 pieces of eight – in this excerpt
# there are at most two, so the option is missing.
object citizen_obj o448.name
  on look
    say citizen o448#1
  end
  on talk
    if not met_citizen
      say citizen r35.s218#13
      set met_citizen
      choose
        option r35.s218#14
          say guybrush r35.s218#14
          say citizen r35.s218#21
          done
        option r35.s218#15
          say guybrush r35.s218#15
          say citizen r35.s218#21
          done
        option r35.s218#16
          say guybrush r35.s218#16
          say citizen r35.s218#19
          say citizen r35.s218#21
          done
        option r35.s218#17
          say guybrush r35.s218#17
          say citizen r35.s218#20
          set c_business
          done
      end
    else
      say citizen r35.s218#1
      if c_offered
        say citizen r35.s218#3
        say citizen r35.s218#4
        set c_price
      else
        choose
          option r35.s218#5
            say guybrush r35.s218#5
            say citizen r35.s218#12
            set c_business
            done
          option r35.s218#6
            say guybrush r35.s218#6
            say citizen r35.s218#10
            set c_business
            done
          option r35.s218#7
            say guybrush r35.s218#7
            say citizen r35.s218#12
            set c_business
            done
          option r35.s218#8
            say guybrush r35.s218#8
            say citizen r35.s218#11
            say citizen r35.s218#37
            done
        end
      end
    end
    if c_business
      clear c_business
      set c_offered
      say citizen r35.s218#25
      wait 120
      say citizen r35.s218#26
      wait 120
      say citizen r35.s218#27
      wait 60
      say citizen r35.s218#28
      say citizen r35.s218#29
      wait 60
      say citizen r35.s218#30
      set c_price
    end
    if c_price
      clear c_price
      choose
        option r35.s218#32
          say guybrush r35.s218#32
          say citizen r35.s218#35
          done
        option r35.s218#34
          say guybrush r35.s218#34
          say citizen r35.s218#38
          done
      end
    end
  end
end

