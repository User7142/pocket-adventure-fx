# Türen muss man wie im Original erst öffnen. Jede Tür ist ein Objektpaar,
# eins je Raum (o437/o322, o323/o894); Zustand 1 = offen.
object bar_entrance o437.name
  on open
    state bar_entrance 1
    state bar_door 1
  end
  on close
    state bar_entrance 0
    state bar_door 0
  end
  on walk
    if bar_entrance open
      room scummbar at 30 54 face right
    end
  end
end

object archway o436.name
  on walk
    # Torbogen zur Stadt (o436): Raum 35 am rechten Torbogen
    room street at 194 48 face left
    walk guybrush 184 58
  end
end

# --- SCUMM Bar -----------------------------------------------------------------
object bar_door o322.name
  on open
    state bar_door 1
    state bar_entrance 1
  end
  on close
    state bar_door 0
    state bar_entrance 0
  end
  on walk
    if bar_door open
      if not seen_ghostship
        # Beim ersten Verlassen der Bar (o322, Bit 446): s117
        set seen_ghostship
        room meanwhile
        wait 60
        say narrator s117#1
        room ghostship
        music ghost_music
        say narrator s117#3
        room ghostcabin
        put lechuck 54 52
        face lechuck left
        put ghost 169 52
        face ghost left
        wait 60
        walk ghost 93 52
        say ghost s117#5
        say lechuck s117#6
        say ghost s117#7
        walk lechuck 70 52
        say lechuck s117#8
        say ghost s117#9
        say lechuck s117#10
        say ghost s117#11
        say lechuck s117#12
        say ghost s117#13
        say lechuck s117#14
        wait 30
        walk ghost 108 52
        wait 30
        walk lechuck 89 52
        face ghost left
        say ghost s117#15
        say ghost s117#16
        walk ghost 120 52
        face ghost left
        say lechuck s117#17
        walk lechuck 54 52
        say lechuck s117#18
        wait 60
        say ghost s117#19
        walk ghost 151 52
        music stop
      end
      room dock at 318 58 face front
    end
  end
end

# Der Koch (r28.s211–s216): Er wartet in der Küche 30 bis 50 Sekunden (s211),
# kommt heraus, bringt einem Piraten Grog und geht zurück (s216). Im Original
# wählt er den Piraten zufällig; hier wechselt er zwischen einem am linken
# Rand und einem bei den wichtig aussehenden Piraten. Wird der Ablauf neu
# gestartet, während er draußen ist, geht er wie bei s216 von dort aus weiter.
routine cook
  repeat
    if not cook_out
      if cook_called
        # r28.s212: nach dem Ruf an der Tür kommt er nach zehn Sekunden
        wait 600
        clear cook_called
      else
        wait random 1800 3000
      end
      set cook_out
      state kitchen_door 1
      state kitchen_exit 1
      put cook 293 55
      walk cook 264 56
    end
    if cook_far
      clear cook_far
      walk cook 210 57
    else
      set cook_far
      walk cook 51 56
    end
    walk cook 264 56
    state kitchen_door 1
    state kitchen_exit 1
    walk cook 293 55
    remove cook
    state kitchen_door 0
    state kitchen_exit 0
    clear cook_out
  end
end

# Klick auf die Küchentür (r28.s203, s214, s215). Das Original sieht schon
# beim Klick nach dem Koch, deshalb ist die Tür „direct“ platziert und die
# Handler lassen Guybrush selbst hinlaufen:
# - Ist der Koch draußen und weit weg (x ≤ 310 im Original), bleibt er
#   stehen, und die Tür funktioniert normal.
# - Ist er draußen und näher, warnt er Guybrush (s215)
#   und serviert dann weiter (x > 520) oder geht zurück in die Küche.
# - Ist er in der Küche und wartet (s211), öffnet er beim Öffnen die Tür,
#   ruft von drinnen und schließt sie wieder (s214); zehn Sekunden später
#   kommt er heraus (s212). In diesen zehn Sekunden geht die Tür auf.
object kitchen_door o323.name
  on open
    if cook_out
      if cook x < 138
        stop cook
        halt cook
        walk guybrush 264 56
        state kitchen_door 1
        state kitchen_exit 1
      else
        halt cook
        face cook right
        say cook r28.s215#1
        if not cook x < 231
          start cook
        else
          stop cook
          walk cook 264 56
          state kitchen_door 1
          state kitchen_exit 1
          walk cook 293 55
          remove cook
          state kitchen_door 0
          state kitchen_exit 0
          clear cook_out
          start cook
        end
      end
    else
      walk guybrush 264 56
      if cook_called
        state kitchen_door 1
        state kitchen_exit 1
      else
        state kitchen_door 1
        state kitchen_exit 1
        wait 30
        say narrator r28.s214#1
        state kitchen_door 0
        state kitchen_exit 0
        set cook_called
        start cook
      end
    end
  end
  on close
    walk guybrush 264 56
    state kitchen_door 0
    state kitchen_exit 0
  end
  on walk
    if cook_out
      if cook x < 138
        stop cook
        halt cook
        walk guybrush 264 56
        if kitchen_door open
          walk guybrush 293 54
          room kitchen at 23 57 face right
        end
      else
        halt cook
        face cook right
        say cook r28.s215#1
        if not cook x < 231
          start cook
        else
          stop cook
          walk cook 264 56
          state kitchen_door 1
          state kitchen_exit 1
          walk cook 293 55
          remove cook
          state kitchen_door 0
          state kitchen_exit 0
          clear cook_out
          start cook
        end
      end
    else
      walk guybrush 264 56
      if kitchen_door open
        walk guybrush 293 54
        room kitchen at 23 57 face right
      end
    end
  end
end

# Der Koch selbst hat keine eigenen Verben (r28: Actor 6 ohne Objekt).
object cook_obj r28.en#1
end

