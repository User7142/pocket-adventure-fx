  entry
    music stop
  end
  place cliffside original 435 face left
  place poster original 438 face front
  place bar_entrance original 437 door face front
  place archway original 436 face right
end

# Raum 28 des Originals: die SCUMM Bar, 640x144 → 284x64. Die Piraten sind
# Objektbilder (je die erste Animationsphase).
room scummbar original 28 tone 55 95 contrast 0 overlay 374 375 376 377 335 341 353 350 356 344 359 362 347 365 368 370
  walkboxes original
  place fireplace original 329 face right
  place curtain original 334 face front
  place bar_door original 322 door face left
  place kitchen_door original 323 door direct face right
  place pirate_a original 341 face left
  place pirate_b original 356 face front
  place pirate_c original 344 face right
  place pirate_d original 347 face front
  place dog original 350 face front
  place leaders_obj original 332 face right
  place mug original 373 picture face left

  entry
    music bar_music
    # r28.s204: am Tisch bei 440,132, Blick nach vorn
    put leaders 196 59
    face leaders front
    # r28.en/s205: Der Koch ist in der Küche, sein Ablauf beginnt von vorn.
    remove cook
    clear cook_out
    clear cook_called
    start cook
  end
end

# s117: eine Zwischenzeile (#1) auf Schwarz, dann das Geisterschiff im Lavafluss
# (Raum 70) und LeChucks Kajüte (Raum 72), je 320×144 → 142×64. Beide sind
# fast nur blau und rot; der Blaukanal zeigt das Schiff als helle Silhouette
# vor der Lava und die Kajüte mit ihren Kanten.
room meanwhile blank
end

room ghostship original 70 tone 20 110 contrast 0.8 channel blue
  walkboxes original
end

room ghostcabin original 72 tone 45 170 contrast 0.6 channel blue
  walkboxes original
end

# Raum 35 des Originals: die Stadtstraße, 480×144 → 213×64
room street original 35 tone 80 220 contrast 0.4 channel max
  walkboxes original
  place street_archway original 458 face right
  place high_street original 459 face left
  place sign original 451 face front
  place clock original 457 face front
  place shop_door original 452 door face front
  place house_door_a original 453 door face front
  place house_door_b original 454 door face front
  place house_door_c original 455 door face front
  place house_door_d original 456 door face front
  place men_obj original 460
  place rat_obj original 461
  place citizen_obj original 448
  entry
    # r35.ex: Var[247] zählt das Verlassen, wenn er auf die Uhr gesehen hat
    if clock_looked
      clear clock_looked
      add clock_visits 1
    end
    # r35.en/s200: die Piraten links, ihre Ratte (solange sie nicht davongelaufen
    # ist), rechts der Kartenverkäufer
    put men 22 55
    face men front
    put citizen 144 52
    face citizen front
    start braak_watch
    if rat_count < 5
      put rat 32 60
      face rat left
      start rat_watch
    end
  end
end

