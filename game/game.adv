# o391: Beim Ansehen bekommt das Huhn einen neuen Namen (setObjectName, o391#2);
# hier sind das zwei Objekte am selben Platz, im Raum wie im Inventar.
object chicken o391.name
  on look
    say guybrush o391#1
    if has chicken
      lose chicken
      pickup rubber_chicken
    else
      hide chicken
      show rubber_chicken
    end
  end
  on pickup
    pickup chicken
    set got_chicken
    say guybrush o391#4
  end
end

